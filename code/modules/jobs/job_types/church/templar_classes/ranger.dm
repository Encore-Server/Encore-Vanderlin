/datum/job/advclass/templar/ranger
	title = "Ranger-Zealot"
	tutorial = "You are a scout, skirmisher, or marksman of the Katholikos; trained in light or ranged equipment and warfare. \
	What you lack in armour and heavy weapons training, you make up for with guile and delivering your Aspect's will from afar, \
	your faith guiding your shots true."
	outfit = /datum/outfit/templar/ranger
	category_tags = list(CTAG_TEMPLAR)

	attribute_sheet = /datum/attribute_holder/sheet/job/templar/ranger

	traits = list(
		TRAIT_MEDIUMARMOR,
		TRAIT_STEELHEARTED,
		TRAIT_VIRGIN,
	)
	mind_traits = list(TRAIT_KNOWBANDITS)

/datum/job/advclass/templar/ranger/on_roundstart(mob/living/carbon/human/spawned, client/player_client)
	. = ..()

	switch(spawned.patron?.type)
		if(/datum/patron/divine/visires)
			spawned.attributes?.add_sheet(/datum/attribute_holder/sheet/job/templar/ranger/patron/visires)
			spawned.cmode_music = 'sound/music/cmode/church/CombatAstrata.ogg'
			var/static/list/selectable = list(
				"Longbow & Shortsword" = list(/obj/item/gun/ballistic/bow/long, /obj/item/ammo_holder/quiver/arrows, /obj/item/weapon/sword/short/silver),
				"Crossbow & Shortsword" = list(/obj/item/gun/ballistic/bow/cross, /obj/item/ammo_holder/quiver/bolts, /obj/item/weapon/sword/short/silver),
				"Silver Sword & Dagger" = list(/obj/item/weapon/sword/silver, /obj/item/weapon/knife/dagger/steel/holysee),
				"Silver Whip & Dagger" = list(/obj/item/weapon/whip/silver, /obj/item/weapon/knife/dagger/steel/holysee),
			)
			var/choice = spawned.select_equippable(player_client, selectable, message = "Choose Your Specialisation", title = "TEMPLAR")
			if(!choice)
				return
			switch(choice)
				if("Longbow & Shortsword")
					spawned.attributes?.add_sheet(/datum/attribute_holder/sheet/job/templar/ranger/patron/visires/bow)
				if("Crossbow & Shortsword")
					spawned.attributes?.add_sheet(/datum/attribute_holder/sheet/job/templar/ranger/patron/visires/crossbow)
				if("Silver Sword & Dagger")
					spawned.attributes?.add_sheet(/datum/attribute_holder/sheet/job/templar/ranger/patron/visires/sword)
				if("Silver Whip & Dagger")
					spawned.attributes?.add_sheet(/datum/attribute_holder/sheet/job/templar/ranger/patron/visires/whip)
		if(/datum/patron/divine/akan)
			spawned.attributes?.add_sheet(/datum/attribute_holder/sheet/job/templar/ranger/patron/akan)
			ADD_TRAIT(spawned, TRAIT_DUALWIELDER, TRAIT_GENERIC)
